# Copy to .env (git-ignored) to configure AI auto-tagging of uploads.
#
# Backend selection — leave as "auto":
#   auto = use ANTHROPIC_API_KEY if set, else the local `claude` CLI, else off
#   api  = API only    cli = `claude` CLI only    off = disable
# DESIGN_LIBRARY_AI_BACKEND=auto

# API backend: get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# CLI backend needs nothing here — just `claude` installed and logged in
# (https://claude.com/claude-code). Verify with: claude --version

# Optional:
# DESIGN_LIBRARY_AI_MODEL=claude-opus-5   # model id (api) or opus|sonnet|haiku (cli)
# DESIGN_LIBRARY_AI_EFFORT=low            # low | medium | high | xhigh | max  (api only)
# PORT=3001
